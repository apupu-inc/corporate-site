{
  "name": "apupu-corporate-site",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "あっぷっぷ corporate website built as static HTML with Eleventy",
  "scripts": {
    "dev": "eleventy --serve",
    "clean": "node -e \"require('node:fs').rmSync('_site', { recursive: true, force: true })\"",
    "build": "npm run clean && eleventy"
  },
  "devDependencies": {
    "@11ty/eleventy": "^3.1.6"
  }
}
