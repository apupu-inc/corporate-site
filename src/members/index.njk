        </div>

        <div class="member-card">
          <div class="member-card__photo">
            <img class="portrait-image" src="{{ '/assets/images/member-coo.jpg' | url }}" alt="惠上裕介（COO）" width="1086" height="1448" loading="lazy" decoding="async">
