---
layout: layouts/base.njk
pageId: news-detail
---
<section class="page-hero">
  <div class="container page-hero__inner">
    <div class="breadcrumbs">
      <a href="{{ '/' | url }}">HOME</a><span>／</span>
      <a href="{{ '/news/' | url }}">お知らせ</a><span>／</span>記事詳細
    </div>
  </div>
</section>

<article class="news-detail">
  <div class="news-detail__meta">
    <time class="news-row__date" datetime="{{ date | htmlDate }}">{{ date | jaDate }}</time>
    <span class="news-row__cat">{{ category }}</span>
  </div>
  <h1 class="news-detail__title">{{ title }}</h1>

  {% if image %}
    <img class="news-detail__image" src="{{ image | url }}" alt="">
  {% else %}
    <div class="ph-img" style="aspect-ratio: 16/9; border-radius: var(--radius); margin-bottom: 40px;">
      <div class="ph-img__label ph-img__label--photo">[記事メイン画像を入力してください]</div>
    </div>
  {% endif %}

  <div class="news-detail__body">{{ content | safe }}</div>

  <div class="news-detail__back">
    <a href="{{ '/news/' | url }}">← お知らせ一覧に戻る</a>
  </div>
</article>

<section class="final-cta">
  <div class="container">
    <h2 class="final-cta__title">APUPUをもっと知る。</h2>
    <div class="final-cta__ctas">
      <a href="{{ '/philosophy/' | url }}" class="btn btn--ghost">教育について <span class="btn__arrow"></span></a>
      <a href="{{ '/method/' | url }}" class="btn btn--ghost">APUPU METHOD <span class="btn__arrow"></span></a>
      <a href="{{ '/contact/' | url }}" class="btn btn--accent">お問い合わせ <span class="btn__arrow"></span></a>
    </div>
  </div>
</section>
