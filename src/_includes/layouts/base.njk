<!doctype html>
<html lang="{{ site.language }}">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{% if title %}{{ title }}｜あっぷっぷ{% else %}{{ site.defaultTitle }}{% endif %}</title>
  <meta name="description" content="{{ description or site.description }}">
  <meta property="og:type" content="{% if pageId == 'news-detail' %}article{% else %}website{% endif %}">
  <meta property="og:title" content="{% if title %}{{ title }}｜あっぷっぷ{% else %}{{ site.defaultTitle }}{% endif %}">
  <meta property="og:description" content="{{ description or site.description }}">
  <meta property="og:locale" content="ja_JP">
  <meta name="twitter:card" content="summary_large_image">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Noto+Serif+JP:wght@300;400;500;600;700&family=Noto+Sans+JP:wght@300;400;500;700&family=EB+Garamond:ital,wght@0,400;0,500;1,400&family=JetBrains+Mono:wght@300;400&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="{{ '/assets/css/main.css' | url }}">
</head>
<body data-tone="A">
  <a class="skip-link" href="#main-content">本文へ移動</a>
  {% include "components/header.njk" %}

  <main id="main-content">
    {{ content | safe }}
  </main>

  {% include "components/footer.njk" %}
  <script src="{{ '/assets/js/main.js' | url }}" defer></script>
</body>
</html>
