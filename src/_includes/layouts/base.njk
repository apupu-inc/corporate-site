<!doctype html>
<html lang="{{ site.language }}">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{% if title %}{{ title }}｜株式会社あっぷっぷ{% else %}{{ site.defaultTitle }}{% endif %}</title>
  <meta name="description" content="{{ description or site.description }}">
  <meta property="og:type" content="{% if pageId == 'news-detail' %}article{% else %}website{% endif %}">
  <meta property="og:title" content="{% if title %}{{ title }}｜株式会社あっぷっぷ{% else %}{{ site.defaultTitle }}{% endif %}">
  <meta property="og:description" content="{{ description or site.description }}">
  <meta property="og:locale" content="ja_JP">
  <meta name="twitter:card" content="summary_large_image">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Noto+Serif+JP:wght@300;400;500;600;700&amp;family=Noto+Sans+JP:wght@300;400;500;700&amp;family=EB+Garamond:ital,wght@0,400;0,500;1,400&amp;family=JetBrains+Mono:wght@300;400&amp;display=swap" rel="stylesheet">
  <link rel="stylesheet" href="{{ '/assets/css/main.css' | url }}">
  <script type="application/ld+json">{"@context":"https://schema.org","@type":"Organization","name":"株式会社あっぷっぷ","foundingDate":"2021-10","email":"support@apupu.family","address":{"@type":"PostalAddress","postalCode":"220-0004","addressRegion":"神奈川県","addressLocality":"横浜市西区","streetAddress":"北幸1丁目11番1号 水信ビル7階"},"sameAs":["{{ site.instagramUrl }}"]}</script>
</head>
<body data-tone="A">
