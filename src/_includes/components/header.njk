<header class="site-header" id="siteHeader">
  <a href="{{ '/' | url }}" class="site-header__brand" aria-label="そろばんあっぷっぷ トップページ">
    <img src="{{ '/assets/images/logo.png' | url }}" alt="そろばんあっぷっぷ APUPU" class="site-header__logo">
  </a>
  <nav class="site-nav" aria-label="グローバルナビゲーション">
    <a href="{{ '/about/' | url }}"{% if pageId == 'about' %} class="is-current" aria-current="page"{% endif %}>私たちについて</a>
    <a href="{{ '/philosophy/' | url }}"{% if pageId == 'philosophy' %} class="is-current" aria-current="page"{% endif %}>教育について</a>
    <a href="{{ '/services/' | url }}"{% if pageId == 'services' %} class="is-current" aria-current="page"{% endif %}>事業・サービス</a>
    <a href="{{ '/method/' | url }}"{% if pageId == 'method' %} class="is-current" aria-current="page"{% endif %}>APUPU METHOD</a>
    <a href="{{ '/message/' | url }}"{% if pageId == 'message' %} class="is-current" aria-current="page"{% endif %}>代表メッセージ</a>
    <a href="{{ '/members/' | url }}"{% if pageId == 'members' %} class="is-current" aria-current="page"{% endif %}>ボードメンバー</a>
    <a href="{{ '/careers/' | url }}"{% if pageId == 'careers' %} class="is-current" aria-current="page"{% endif %}>採用情報</a>
    <a href="{{ '/news/' | url }}"{% if pageId == 'news' or pageId == 'news-detail' %} class="is-current" aria-current="page"{% endif %}>お知らせ</a>
    <a href="{{ '/company/' | url }}"{% if pageId == 'company' %} class="is-current" aria-current="page"{% endif %}>会社概要</a>
    <a href="{{ '/contact/' | url }}"{% if pageId == 'contact' %} class="is-current" aria-current="page"{% endif %}>お問い合わせ</a>
  </nav>
  <a href="{{ site.trialUrl }}" class="site-header__cta">
    <span>体験・入会</span>
    <svg viewBox="0 0 20 20" fill="none" width="14" height="14" aria-hidden="true"><path d="M4 10h12M11 5l5 5-5 5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
  </a>
  <button class="site-header__menu" id="menuToggle" type="button" aria-label="メニュー" aria-controls="mobileMenu" aria-expanded="false">
    <span></span><span></span><span></span>
  </button>
</header>

<div class="mobile-menu" id="mobileMenu" aria-hidden="true">
  <div class="mobile-menu__inner">
    <nav aria-label="モバイルナビゲーション">
      <a href="{{ '/' | url }}">トップ</a>
      <a href="{{ '/about/' | url }}">私たちについて</a>
      <a href="{{ '/philosophy/' | url }}">教育について</a>
      <a href="{{ '/services/' | url }}">事業・サービス</a>
      <a href="{{ '/method/' | url }}">APUPU METHOD</a>
      <a href="{{ '/message/' | url }}">代表メッセージ</a>
      <a href="{{ '/members/' | url }}">ボードメンバー</a>
      <a href="{{ '/careers/' | url }}">採用情報</a>
      <a href="{{ '/partners/' | url }}">パートナー・提携</a>
      <a href="{{ '/news/' | url }}">お知らせ</a>
      <a href="{{ '/company/' | url }}">会社概要</a>
      <a href="{{ '/contact/' | url }}">お問い合わせ</a>
      <a href="{{ '/privacy/' | url }}" class="is-sub">プライバシーポリシー</a>
    </nav>
    <a href="{{ site.trialUrl }}" class="mobile-menu__cta">体験・入会はこちら →</a>
  </div>
</div>
