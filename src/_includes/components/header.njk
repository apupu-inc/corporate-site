<header class="site-header" id="siteHeader">
  <div class="site-header__inner">
    <a href="{{ '/' | url }}" class="site-header__brand" aria-label="そろばんあっぷっぷ トップページ">
      <img src="{{ '/assets/images/logo.png' | url }}" alt="そろばんあっぷっぷ" class="site-header__logo">
    </a>

    <nav class="site-nav" aria-label="グローバルナビゲーション">
    <div class="site-nav__group{% if pageId == 'about' or pageId == 'philosophy' or pageId == 'method' %} is-current{% endif %}">
      <button class="site-nav__trigger" type="button" data-nav-dropdown aria-expanded="false" aria-controls="nav-about">
        あっぷっぷについて <span class="site-nav__chevron" aria-hidden="true"></span>
      </button>
      <div class="site-nav__dropdown" id="nav-about">
        <a href="{{ '/about/' | url }}"{% if pageId == 'about' %} aria-current="page"{% endif %}>私たちについて</a>
        <a href="{{ '/philosophy/' | url }}"{% if pageId == 'philosophy' %} aria-current="page"{% endif %}>教育について</a>
        <a href="{{ '/method/' | url }}"{% if pageId == 'method' %} aria-current="page"{% endif %}>あっぷっぷ METHOD</a>
      </div>
    </div>

    <a href="{{ '/services/' | url }}"{% if pageId == 'services' %} class="is-current" aria-current="page"{% endif %}>サービス</a>

    <div class="site-nav__group{% if pageId == 'company' %} is-current{% endif %}">
      <button class="site-nav__trigger" type="button" data-nav-dropdown aria-expanded="false" aria-controls="nav-company">
        会社情報 <span class="site-nav__chevron" aria-hidden="true"></span>
      </button>
      <div class="site-nav__dropdown" id="nav-company">
        <a href="{{ '/company/#message' | url }}">代表メッセージ</a>
        <a href="{{ '/company/#members' | url }}">ボードメンバー</a>
        <a href="{{ '/company/#profile' | url }}">会社概要</a>
        <a href="{{ '/company/#partners' | url }}">パートナー・提携</a>
      </div>
    </div>

    <a href="{{ '/careers/' | url }}"{% if pageId == 'careers' %} class="is-current" aria-current="page"{% endif %}>採用情報</a>
    <a href="{{ '/news/' | url }}"{% if pageId == 'news' or pageId == 'news-detail' %} class="is-current" aria-current="page"{% endif %}>お知らせ</a>
    <a href="{{ '/contact/' | url }}"{% if pageId == 'contact' %} class="is-current" aria-current="page"{% endif %}>お問い合わせ</a>
    </nav>

    <button class="site-header__menu" id="menuToggle" type="button" aria-label="メニュー" aria-controls="mobileMenu" aria-expanded="false">
      <span></span><span></span><span></span>
    </button>
  </div>
</header>

<div class="mobile-menu" id="mobileMenu" aria-hidden="true">
  <div class="mobile-menu__inner">
    <nav aria-label="モバイルナビゲーション">
      <a href="{{ '/' | url }}">トップ</a>

      <div class="mobile-menu__section">
        <div class="mobile-menu__heading">あっぷっぷについて</div>
        <div class="mobile-menu__subnav">
          <a href="{{ '/about/' | url }}">私たちについて</a>
          <a href="{{ '/philosophy/' | url }}">教育について</a>
          <a href="{{ '/method/' | url }}">あっぷっぷ METHOD</a>
        </div>
      </div>

      <a href="{{ '/services/' | url }}">サービス</a>

      <div class="mobile-menu__section">
        <a class="mobile-menu__heading mobile-menu__heading--link" href="{{ '/company/' | url }}">会社情報</a>
        <div class="mobile-menu__subnav">
          <a href="{{ '/company/#message' | url }}">代表メッセージ</a>
          <a href="{{ '/company/#members' | url }}">ボードメンバー</a>
          <a href="{{ '/company/#profile' | url }}">会社概要</a>
          <a href="{{ '/company/#partners' | url }}">パートナー・提携</a>
        </div>
      </div>

      <a href="{{ '/careers/' | url }}">採用情報</a>
      <a href="{{ '/news/' | url }}">お知らせ</a>
      <a href="{{ '/contact/' | url }}">お問い合わせ</a>
    </nav>
    <a href="{{ site.trialUrl }}" class="mobile-menu__cta">体験・入会はこちら →</a>
  </div>
</div>
